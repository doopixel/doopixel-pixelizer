{% comment %}
  Add this Custom Liquid section to the Cart template.
  It renders compact buttons and dialogs for Custom Pixel Pieces import lines.
{% endcomment %}

{% assign dp_has_matching_parts = false %}
{% for item in cart.items %}
  {% if item.variant_id == 57037331595430 %}
    {% assign dp_has_matching_parts = true %}
  {% endif %}
{% endfor %}

{% if dp_has_matching_parts %}
  <style>
    .dp-cart-parts { width: 0; height: 0; margin: 0; padding: 0; }
    .dp-cart-parts__item { display: none; }
    .dp-cart-parts__item.is-mounted { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 10px; padding: 10px 12px; border: 1px solid #b9ddc4; background: #f2faf4; }
    .dp-cart-parts__title { margin: 0; font-weight: 700; }
    .dp-cart-parts__meta { margin: 5px 0 0; color: #666; font-size: 13px; }
    .dp-cart-parts__button { min-height: 38px; border: 1px solid #1f9d48; padding: 7px 13px; color: #fff; background: #1f9d48; font: inherit; font-weight: 700; cursor: pointer; white-space: nowrap; }
    .dp-cart-parts__button:hover { border-color: #14733b; background: #14733b; }
    .dp-parts-dialog { width: min(760px, calc(100vw - 28px)); max-height: min(760px, calc(100vh - 40px)); border: 0; padding: 0; color: #171717; background: #fff; box-shadow: 0 24px 70px rgba(0,0,0,.28); }
    .dp-parts-dialog::backdrop { background: rgba(13,16,25,.58); }
    .dp-parts-dialog__head { position: sticky; top: 0; display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding: 22px 24px; border-bottom: 1px solid #dfe2ea; background: #fff; }
    .dp-parts-dialog__head h2 { margin: 0; font-size: 24px; }
    .dp-parts-dialog__head p { margin: 5px 0 0; color: #666; font-size: 13px; }
    .dp-parts-dialog__close { width: 38px; height: 38px; border: 1px solid #ccc; color: #171717; background: #fff; font-size: 24px; line-height: 1; cursor: pointer; }
    .dp-parts-dialog__body { padding: 0 24px 24px; overflow-y: auto; }
    .dp-parts-dialog__table-wrap { overflow-x: auto; scrollbar-width: thin; scrollbar-color: #1f9d48 #dfece3; }
    .dp-parts-dialog__table-wrap::-webkit-scrollbar { height: 8px; }
    .dp-parts-dialog__table-wrap::-webkit-scrollbar-track { background: #dfece3; border-radius: 999px; }
    .dp-parts-dialog__table-wrap::-webkit-scrollbar-thumb { background: #1f9d48; border-radius: 999px; }
    .dp-parts-dialog table { width: 100%; min-width: 590px; border-collapse: collapse; }
    .dp-parts-dialog th, .dp-parts-dialog td { padding: 12px 9px; border-bottom: 1px solid #e3e3e3; text-align: left; }
    .dp-parts-dialog th { color: #626774; font-size: 11px; letter-spacing: .05em; text-transform: uppercase; }
    .dp-parts-dialog td:first-child, .dp-parts-dialog td:nth-child(3) { font-weight: 700; }
    .dp-parts-dialog__color { display: inline-flex; align-items: center; gap: 9px; white-space: nowrap; }
    .dp-parts-dialog__swatch { width: 22px; height: 22px; border: 1px solid rgba(0,0,0,.22); border-radius: 50%; box-shadow: inset 0 0 0 2px rgba(255,255,255,.3); }
    .dp-parts-dialog__swatch--1 { background: #212121; }
    .dp-parts-dialog__swatch--2 { background: #0057a6; }
    .dp-parts-dialog__swatch--3 { background: #10cb31; }
    .dp-parts-dialog__swatch--4 { background: #9fc3e9; }
    .dp-parts-dialog__swatch--5 { background: #f7ba30; }
    .dp-parts-dialog__swatch--6 { background: #f3e055; }
    .dp-parts-dialog__swatch--7 { background: #ffbbff; }
    .dp-parts-dialog__swatch--8 { background: #532115; }
    .dp-parts-dialog__swatch--9 { background: #f88379; }
    .dp-parts-dialog__swatch--10 { background: #3399ff; }
    .dp-parts-dialog__swatch--11 { background: #143044; }
    .dp-parts-dialog__swatch--12 { background: #595d60; }
    .dp-parts-dialog__swatch--13 { background: #330000; }
    .dp-parts-dialog__swatch--14 { background: #6b5a5a; }
    .dp-parts-dialog__swatch--15 { background: #b35408; }
    .dp-parts-dialog__swatch--16 { background: #c87080; }
    .dp-parts-dialog__swatch--17 { background: #5f2683; }
    .dp-parts-dialog__swatch--18 { background: #6a0e15; }
    .dp-parts-dialog__swatch--19 { background: #907450; }
    .dp-parts-dialog__swatch--20 { background: #008a80; }
    .dp-parts-dialog__swatch--21 { background: #898788; }
    .dp-parts-dialog__swatch--22 { background: #00642e; }
    .dp-parts-dialog__swatch--23 { background: #b18cbf; }
    .dp-parts-dialog__swatch--24 { background: #ccffff; }
    .dp-parts-dialog__swatch--25 { background: #afb5c7; }
    .dp-parts-dialog__swatch--26 { background: #9c9c9c; }
    .dp-parts-dialog__swatch--27 { background: #feccb0; }
    .dp-parts-dialog__swatch--28 { background: #a6ca55; }
    .dp-parts-dialog__swatch--29 { background: #b52952; }
    .dp-parts-dialog__swatch--30 { background: #42c0fb; }
    .dp-parts-dialog__swatch--31 { background: #61afff; }
    .dp-parts-dialog__swatch--32 { background: #885e9e; }
    .dp-parts-dialog__swatch--33 { background: #bdc618; }
    .dp-parts-dialog__swatch--34 { background: #e3a05b; }
    .dp-parts-dialog__swatch--35 { background: #fffc00; }
    .dp-parts-dialog__swatch--36 { background: #ffaf7d; }
    .dp-parts-dialog__swatch--37 { background: #7c9051; }
    .dp-parts-dialog__swatch--38 { background: #ff7e14; }
    .dp-parts-dialog__swatch--39 { background: #666660; }
    .dp-parts-dialog__swatch--40 { background: #e79500; }
    .dp-parts-dialog__swatch--41 { background: #b30006; }
    .dp-parts-dialog__swatch--42 { background: #89351d; }
    .dp-parts-dialog__swatch--43 { background: #5a7184; }
    .dp-parts-dialog__swatch--44 { background: #76a290; }
    .dp-parts-dialog__swatch--45 { background: #dec69c; }
    .dp-parts-dialog__swatch--46 { background: #ffffff; }
    .dp-parts-dialog__swatch--47 { background: #f7d117; }
    .dp-parts-dialog__swatch--48 { background: #dfeea5; }
    .dp-parts-dialog__scroll-progress { display: none; height: 6px; margin: 10px 2px 0; overflow: hidden; border-radius: 999px; background: #dfece3; }
    .dp-parts-dialog__scroll-progress span { display: block; width: 100%; height: 100%; border-radius: inherit; background: #1f9d48; transform: translateX(0); }
    @media (max-width: 640px) {
      .dp-cart-parts__item.is-mounted { align-items: flex-start; flex-direction: column; }
      .dp-parts-dialog__head { padding: 18px; }
      .dp-parts-dialog__body { padding: 0 12px 18px; }
      .dp-parts-dialog th, .dp-parts-dialog td { padding: 10px 7px; }
      .dp-parts-dialog__scroll-progress { display: block; }
      .dp-parts-dialog__scroll-progress--top { margin: 10px 2px; }
    }
  </style>

  <div class="dp-cart-parts" aria-label="Matching Parts Details">
    {% for item in cart.items %}
      {% if item.variant_id == 57037331595430 %}
        {% assign dp_modal_id = 'dp-parts-dialog-' | append: forloop.index %}
        <div class="dp-cart-parts__item" data-dp-cart-line="{{ forloop.index }}">
          <div>
            <p class="dp-cart-parts__title">Matching Parts Details</p>
            <p class="dp-cart-parts__meta">{{ item.quantity }} × 100-piece packs</p>
          </div>
          <button class="dp-cart-parts__button" type="button" data-dp-dialog-open="{{ dp_modal_id }}">View Parts</button>
        </div>

        <dialog class="dp-parts-dialog" id="{{ dp_modal_id }}">
          <div class="dp-parts-dialog__head">
            <div>
              <h2>Matching Parts</h2>
              <p>DooPixel warehouse numbers and quantities for this cart item.</p>
            </div>
            <button class="dp-parts-dialog__close" type="button" data-dp-dialog-close aria-label="Close">×</button>
          </div>
          <div class="dp-parts-dialog__body">
            <div class="dp-parts-dialog__scroll-progress dp-parts-dialog__scroll-progress--top" aria-hidden="true"><span></span></div>
            <div class="dp-parts-dialog__table-wrap" data-dp-scroll-table>
              <table>
                <thead><tr><th>Doo Number</th><th>Color</th><th>Qty</th><th>Part Type</th></tr></thead>
                <tbody>
                  {% for property in item.properties %}
                    {% assign dp_property_parts = property.first | split: ' · ' %}
                    {% if dp_property_parts[0] == '_Pick' %}
                      {% assign dp_color_number = dp_property_parts[1] | remove: 'A' %}
                      <tr>
                        <td>{{ dp_property_parts[1] | escape }}</td>
                        <td><span class="dp-parts-dialog__color"><span class="dp-parts-dialog__swatch dp-parts-dialog__swatch--{{ dp_color_number | escape }}"></span>{{ dp_property_parts[2] | escape }}</span></td>
                        <td>{{ property.last | escape }}</td>
                        <td>{{ dp_property_parts[3] | escape }}</td>
                      </tr>
                    {% endif %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <div class="dp-parts-dialog__scroll-progress" aria-hidden="true"><span></span></div>
          </div>
        </dialog>
      {% endif %}
    {% endfor %}
  </div>

  <script>
    (function () {
      var mountQueued = false;
      function mountPartsDetails() {
        document.querySelectorAll('.dp-cart-parts > .dp-cart-parts__item[data-dp-cart-line]').forEach(function (template) {
          var line = template.getAttribute('data-dp-cart-line');
          var container = document.querySelector('.item-cart[data-line="' + line + '"]') || document.querySelector('[data-cart-item][data-line="' + line + '"]');
          var target = container && (container.querySelector('.cart-table__col--product .info') || container.querySelector('.cart-item__details'));
          if (target && !target.querySelector('.dp-cart-parts__item[data-dp-mounted-line="' + line + '"]')) {
            var card = template.cloneNode(true);
            card.removeAttribute('data-dp-cart-line');
            card.setAttribute('data-dp-mounted-line', line);
            card.classList.add('is-mounted');
            target.appendChild(card);
          }
          if (!container) return;
          container.querySelectorAll('details').forEach(function (details) {
            var summary = details.querySelector('summary');
            if (summary && /design details/i.test(summary.textContent || '')) details.hidden = true;
          });
        });
      }
      function updateScrollProgress(wrap) {
        var tracks = [wrap.previousElementSibling, wrap.nextElementSibling].filter(function (track) {
          return track && track.classList.contains('dp-parts-dialog__scroll-progress');
        });
        if (!tracks.length) return;
        var scrollable = wrap.scrollWidth > wrap.clientWidth + 1;
        tracks.forEach(function (track) {
          var thumb = track.firstElementChild;
          track.style.visibility = scrollable ? 'visible' : 'hidden';
          if (!scrollable) return;
          var ratio = Math.min(1, wrap.clientWidth / wrap.scrollWidth);
          var thumbWidth = Math.max(28, track.clientWidth * ratio);
          var travel = Math.max(0, track.clientWidth - thumbWidth);
          var progress = wrap.scrollLeft / Math.max(1, wrap.scrollWidth - wrap.clientWidth);
          thumb.style.width = thumbWidth + 'px';
          thumb.style.transform = 'translateX(' + (travel * progress) + 'px)';
        });
      }
      function refresh() {
        mountPartsDetails();
        document.querySelectorAll('[data-dp-scroll-table]').forEach(updateScrollProgress);
      }
      function queueRefresh() {
        if (mountQueued) return;
        mountQueued = true;
        requestAnimationFrame(function () { mountQueued = false; refresh(); });
      }
      document.addEventListener('click', function (event) {
        var openButton = event.target.closest('[data-dp-dialog-open]');
        if (openButton) {
          var dialog = document.getElementById(openButton.getAttribute('data-dp-dialog-open'));
          if (dialog && typeof dialog.showModal === 'function') {
            dialog.showModal();
            requestAnimationFrame(function () { dialog.querySelectorAll('[data-dp-scroll-table]').forEach(updateScrollProgress); });
          }
          return;
        }
        var closeButton = event.target.closest('[data-dp-dialog-close]');
        if (closeButton) closeButton.closest('dialog').close();
      });
      document.querySelectorAll('.dp-parts-dialog').forEach(function (dialog) {
        dialog.addEventListener('click', function (event) {
          if (event.target === dialog) dialog.close();
        });
      });
      document.querySelectorAll('[data-dp-scroll-table]').forEach(function (wrap) {
        wrap.addEventListener('scroll', function () { updateScrollProgress(wrap); }, { passive: true });
      });
      window.addEventListener('resize', queueRefresh);
      refresh();
      new MutationObserver(queueRefresh).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
{% endif %}
